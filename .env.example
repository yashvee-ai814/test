# Ollama connection, used by backend/llm.py and mcp_server/vector_tools.py
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gpt-oss:120b-cloud

# mcp_server/server.py bind address
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001

# backend/mcp_client.py - where it finds the MCP server
MCP_SERVER_URL=http://127.0.0.1:8001/mcp

# frontend build-time var (Vite) - where it finds the backend
VITE_AGENT_API_URL=http://localhost:8000
